# Database
DATABASE_URL="postgresql://user:password@localhost:5432/app_growth_desk"

# Private single-owner login (generate hash with: npx bcryptjs-cli hash "yourpassword")
OWNER_EMAIL="you@example.com"
OWNER_PASSWORD_HASH=""

# Session signing
AUTH_SECRET="change-me-to-a-long-random-string"

# Encrypts App Store Connect / Apple Ads credentials at rest
CREDENTIALS_ENCRYPTION_KEY="change-me-to-a-long-random-string"

# AI provider (OpenAI-compatible)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Ranking provider: apple_lookup | third_party_aso_api | internal_crawler
RANKING_PROVIDER="apple_lookup"

# Redis (for BullMQ background rank-tracking jobs, Phase 2)
REDIS_URL="redis://localhost:6379"
